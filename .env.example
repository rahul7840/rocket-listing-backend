PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=rocket listing
DB_LOGGING=false

# Gemini API key for the listing-generator module (src/modules/listing-generator).
# Get one from https://aistudio.google.com/apikey - never commit a real value.
GEMINI_API_KEY=
# Optional: override the model id set in src/modules/listing-generator/config/model.configure.ts
GEMINI_MODEL=gemini-2.5-flash-lite

# image-processing module (src/modules/image-processing) - local storage for generated image variants
IMAGE_UPLOAD_DIR=uploads
IMAGE_PUBLIC_PATH=/uploads
IMAGE_MAX_UPLOAD_MB=15

# auth module (src/modules/auth) - Google sign-in only, no Firebase.
# Comma-separated OAuth 2.0 "Chrome Extension" client IDs from
# https://console.cloud.google.com/apis/credentials?project=rocket-listing
# - one per extension build (local dev id + Chrome Web Store id). A token
# whose audience isn't in this list is rejected.
GOOGLE_OAUTH_CLIENT_IDS=

# Secret used to sign our own session JWTs (issued by POST /auth/google after
# verifying the Google token). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit a real value.
JWT_SECRET=
JWT_EXPIRES_IN=30d
