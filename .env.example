PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=rocket listing
DB_LOGGING=false

# Gemini API key for the listing-generator module (src/modules/listing-generator).
# Get one from https://aistudio.google.com/apikey - never commit a real value.
GEMINI_API_KEY=
# Optional: override the model id set in src/modules/listing-generator/config/model.configure.ts
GEMINI_MODEL=gemini-2.5-flash-lite

# image-processing module (src/modules/image-processing) - local storage for generated image variants
IMAGE_UPLOAD_DIR=uploads
IMAGE_PUBLIC_PATH=/uploads
IMAGE_MAX_UPLOAD_MB=15
